# RUN: llc -start-after=patchable-function -filetype=obj %s -o - | llvm-dwarfdump --debug-info - | FileCheck %s
#
# An IR entry constant is evidence only for that value. If its machine record
# has disappeared, the first surviving assignment of a different constant must
# not borrow the entry coverage.
# CHECK: DW_TAG_subprogram
# CHECK: DW_AT_low_pc (0x[[#%.16x,BEGIN:]])
# CHECK: DW_AT_name ("changed_constant")
# CHECK: DW_TAG_formal_parameter
# CHECK: DW_AT_location
# CHECK-NEXT: [0x[[#%.16x,BEGIN+6]], {{.*}}): DW_OP_consts +23, DW_OP_stack_value)
# CHECK: DW_AT_name ("arg")
--- |
  target triple = "x86_64-unknown-linux-gnu"

  define void @changed_constant(i64 %arg) !dbg !4 {
      #dbg_value(i64 7, !7, !DIExpression(), !8)
    call void @checkpoint(), !dbg !9
      #dbg_value(i64 23, !7, !DIExpression(), !10)
    call void @checkpoint(), !dbg !10
    ret void, !dbg !10
  }

  declare void @checkpoint()

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2, !3}
  !0 = distinct !DICompileUnit(language: DW_LANG_C, file: !1, producer: "regression", isOptimized: true, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "parameters.c", directory: "/")
  !2 = !{i32 2, !"Dwarf Version", i32 4}
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = distinct !DISubprogram(name: "changed_constant", scope: !1, file: !1, line: 1, type: !5, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0)
  !5 = !DISubroutineType(types: !{})
  !6 = !DIBasicType(name: "long", size: 64, encoding: DW_ATE_signed)
  !7 = !DILocalVariable(name: "arg", arg: 1, scope: !4, file: !1, line: 1, type: !6)
  !8 = !DILocation(line: 1, column: 1, scope: !4)
  !9 = !DILocation(line: 2, column: 1, scope: !4)
  !10 = !DILocation(line: 3, column: 1, scope: !4)
...
---
name: changed_constant
tracksRegLiveness: true
frameInfo:
  stackSize: 8
body: |
  bb.0:
    frame-setup PUSH64r undef $rax, implicit-def $rsp, implicit $rsp
    CFI_INSTRUCTION def_cfa_offset 16
    CALL64pcrel32 @checkpoint, csr_64, implicit $rsp, implicit $ssp, implicit-def $rsp, implicit-def $ssp, debug-location !9
    DBG_VALUE 23, $noreg, !7, !DIExpression(), debug-location !10
    CALL64pcrel32 @checkpoint, csr_64, implicit $rsp, implicit $ssp, implicit-def $rsp, implicit-def $ssp, debug-location !10
    $rax = frame-destroy POP64r implicit-def $rsp, implicit $rsp, debug-location !10
    CFI_INSTRUCTION def_cfa_offset 8
    RET64 debug-location !10
...
